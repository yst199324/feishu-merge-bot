# ------------------------------------------------------------------
# 服务器部署用的 .env 模板。
#
# 用法：
#   1. cp .env.example .env
#   2. 把下面的值换成这台服务器真实用的
#   3. 和 merge-bot.jar、application.yml 放在同一目录
#
# 这个文件是本机专属的，**永远不要用别处覆盖它**。
# 相反，application.yml 可以随时整份覆盖过来 ——
# 那份里所有真实值都是 ${KEY:占位} 形式，会从这个文件取值。
#
# .env 已被 .gitignore 排除，不会进仓库。
# ------------------------------------------------------------------

# 服务监听端口。云效 Webhook 的 URL 要填 http://你的公网IP:这个端口/webhook/yunxiao
SERVER_PORT=18123

# 排错接口 /test/* 的开关。服务器上必须是 false（默认值就是 true，所以这行不能省）。
# 改成 true 可以让 /test/doctor 一键自检，验完立刻改回来。
TEST_ENDPOINTS=false

# 【飞书】开发者后台 -> 你的应用 -> 凭证与基础信息
FEISHU_APP_ID=cli_你的应用ID
FEISHU_APP_SECRET=在这里粘贴AppSecret

# 【飞书】审批群 ID（oc_ 开头）
# 拿法：群里右上角「设置」-> 一直拉到最底部 ->「会话 ID」
FEISHU_CHAT_ID=oc_你的群会话ID

# 【云效】个人访问令牌（pt- 开头）
# 拿法：云效右上角头像 -> 个人设置 -> 个人访问令牌
YUNXIAO_TOKEN=pt-xxxxxxxxxxxxxxxx

# 【云效】组织 ID（一串十六进制）
# 拿法：云效「组织设置 -> 基本信息」，或看网页地址栏第一段
YUNXIAO_ORG_ID=你的组织ID

# 【云效】Webhook 的 Secret Token，自己定一个随机字符串
# 要和云效「代码库 -> 设置 -> Webhooks」里填的完全一致
YUNXIAO_WEBHOOK_TOKEN=在这里填一个随机字符串
