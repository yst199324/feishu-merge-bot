target/
logs/
*.log
.idea/
*.iml

# 本地临时文件（maven classpath 导出）
cp.txt

# 部署产物：jar 是构建生成的，不入库（本地 mvn package 或看 deploy 说明）
deploy/*.jar

# 注意：deploy/application.yml 是入库的（新克隆下来就能直接部署）。
# 它必须和 src/main/resources/application.yml 逐字一致，有这个拷贝是为了
# "jar 同级必须有一份 application.yml"，start.sh 会检查。改一处记得改另一处，
# 忘了会有测试 DeployConfigSyncTest 直接报错。

# 服务器上的真实值（凭据 + 端口），不入库。模板见 deploy/.env.example
deploy/.env

# 本地开发的真实配置，不入库。模板见 .env.example
# 只忽略根目录那个 .env，不影响 .env.example
/.env

# 设计与方案文档只在本地留存，不推到公开仓库
docs/
