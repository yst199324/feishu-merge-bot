target/
logs/
*.log
.idea/
*.iml

# 本地临时文件（maven classpath 导出）
cp.txt

# 部署产物：jar 是构建生成的，不入库（本地 mvn package 或看 deploy 说明）
deploy/*.jar

# 服务器上的拷贝件，直接从 src/main/resources/application.yml 复制，不入库
deploy/application.yml

# 服务器上的真实值（凭据 + 端口），不入库。模板见 deploy/.env.example
deploy/.env

# 本地开发的真实配置，不入库。模板见 .env.example
# 只忽略根目录那个 .env，不影响 .env.example
/.env
